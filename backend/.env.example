# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/nexus_r
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=nexus_r

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
LLM_PROVIDER=openai  # openai or anthropic
LLM_MODEL=gpt-4-turbo-preview  # or claude-3-opus-20240229

# External APIs (Optional - Mock mode used if not provided)
IMD_API_KEY=
GDACS_API_URL=https://www.gdacs.org/gdacsapi/api/events/geteventlist/SEARCH
MOSDAC_API_KEY=
ROUTING_PROVIDER=simulation  # simulation or osrm

# Application
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
