# Database — Postgres for docker/demo; SQLite remains valid for local unit tests
# DATABASE_URL=sqlite:///./nexus_r.db
DATABASE_URL=postgresql+psycopg2://codecommit:codecommit@localhost:5432/nexus_r
POSTGRES_USER=codecommit
POSTGRES_PASSWORD=codecommit
POSTGRES_DB=nexus_r
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4-turbo-preview

# Data mode: simulation (default, demo-safe) or live
DATA_MODE=simulation
GDACS_MODE=
IMD_MODE=
MOSDAC_MODE=
ROUTING_MODE=

# GDACS — public Events API (no key). Live only when GDACS_MODE=live or DATA_MODE=live
GDACS_API_URL=https://www.gdacs.org/gdacsapi/api/Events/geteventlist/latest

# IMD — https://api.imd.gov.in/public/index.php (account + API key required for live)
IMD_API_BASE=https://api.imd.gov.in/api/v1
IMD_API_KEY=

# MOSDAC — account/dataset URL required for live; otherwise adapter + simulation
MOSDAC_API_URL=
MOSDAC_API_KEY=

# Routing — keep simulation unless OSRM_BASE_URL is set AND ROUTING_MODE=live
ROUTING_PROVIDER=simulation
OSRM_BASE_URL=

# Application
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SSE_ENABLED=true

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
